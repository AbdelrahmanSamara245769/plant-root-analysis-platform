# Copy to .env and fill in. docker/.env.example holds the Postgres settings for Docker Compose.

# Database (SQLite works for local development)
DATABASE_URL=postgresql+psycopg://cv4:changeme@localhost:5433/cv4

# Authentication. Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-secret
CV4_ENV=development
CV4_CORS_ORIGINS=http://localhost:3000

# Inference: "local" runs the U-Net in the API process, "remote" calls the Azure ML endpoint
CV4_INFERENCE_MODE=local
AZURE_ML_ENDPOINT_URL=https://<endpoint-name>.<region>.inference.ml.azure.com/score
AZURE_ML_ENDPOINT_KEY=your-endpoint-key
AZURE_ML_DEPLOYMENT_NAME=blue

# Azure ML workspace (training pipelines, sweeps, registration, scheduled retraining)
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_WORKSPACE_NAME=your-workspace
AZURE_COMPUTE=your-compute-target
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your-client-secret

# Monitoring (optional)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Container images for docker/docker-compose.portainer.yml
CV4_IMAGE_PREFIX=ghcr.io/your-account/plant-root-analysis-platform
